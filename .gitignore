# build output
dist/
# generated types
.astro/
# 构建期生成（scripts/build-version.cjs），版本号随 commit 变，
# 提交进去立刻就是"过期"状态，由 CI/本地构建重新生成
public/LumeOS/version.json

# dependencies
node_modules/

# 本地 Python 运行时（scripts/pyodide-vendor.cjs 解出来的 13MB 二进制）
# 落点是 public/LumeOS/vendor/pyodide —— 只有 public 下的文件能被 dev server
# 端出来；仓库里不放它，CI 构建也就不会把它带进 dist
vendor/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vscode/

# external-drive trash folder
.Trash-0/

# workbuddy project data / agent memory (do not publish)
.workbuddy/
